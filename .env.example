# Plus nécessaire : la carte utilise Leaflet / OpenStreetMap.
# VITE_GOOGLE_MAPS_API_KEY=

# URL de base de l'API backend (FastAPI).
# En dev  : "/api" → proxy Vite vers http://localhost:8000
# En prod : URL absolue, ex: https://api.example.com/api
VITE_API_BASE_URL=/api

# Clé créée sur https://console.groq.com/keys
# Ne pas préfixer par VITE_ : le navigateur ne doit pas la voir.
GROQ_API_KEY=

# Modèle gratuit Groq. Autres identifiants possibles :
# openai/gpt-oss-120b
# qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b
